FROM node:22-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git tini unzip && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://bun.sh/install | bash -s "bun-v1.3.12" && install -m 0755 /root/.bun/bin/bun /usr/local/bin/bun && rm -rf /root/.bun
WORKDIR /app
COPY agent-runner/package.json agent-runner/bun.lock ./
RUN bun install
COPY entrypoint.sh /app/entrypoint.sh
RUN tr -d '\r' < /app/entrypoint.sh > /tmp/entrypoint.sh && mv /tmp/entrypoint.sh /app/entrypoint.sh && chmod +x /app/entrypoint.sh
RUN mkdir -p /workspace/group /workspace/extra && chmod 777 /home/node
USER node
WORKDIR /workspace/group
ENTRYPOINT ["/usr/bin/tini", "--", "/app/entrypoint.sh"]
